+extern "C" JNIEXPORT jboolean JNICALL
+Java_io_github_arancormonk_dsdneo_DsdNative_nativeVoiceTune(JNIEnv* env, jobject, jlongArray values, jint modulation) {
+    if(!values || env->GetArrayLength(values)!=10) return JNI_FALSE;
+    jlong v[10]; env->GetLongArrayRegion(values,0,10,v);
+    for(int i=0;i<10;++i) if(v[i]<0 || (i>0 && v[i]>UINT32_MAX)) return JNI_FALSE;
+    dsd_voice_tune t{};
+    t.grant={static_cast<uint64_t>(v[0]),static_cast<uint32_t>(v[1]),static_cast<uint32_t>(v[2]),static_cast<uint32_t>(v[3]),
+        static_cast<uint32_t>(v[4]),static_cast<uint32_t>(v[5]),static_cast<uint32_t>(v[6]),static_cast<int>(v[7]),static_cast<int>(v[8]),static_cast<int>(v[9])};
+    t.modulation=modulation;
+    if(!dsd_voice_tune_valid(&t)) return JNI_FALSE;
+    dsd_voice_tune_result(t.grant.sequence,0);
+    if(dsd_app_command_submit(DSD_APP_CMD_P25_VOICE_TUNE,&t,sizeof(t))<0) { dsd_voice_tune_result(t.grant.sequence,-1); return JNI_FALSE; }
+    return JNI_TRUE;
+}
+extern "C" JNIEXPORT jlongArray JNICALL
+Java_io_github_arancormonk_dsdneo_DsdNative_nativeVoiceTuneStatus(JNIEnv* env, jobject) {
