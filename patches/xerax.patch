+double SpectrumModel::channelExcessDb(double widthHz) const {
+    if (!m_has_data || m_bin_count < 16 || !(m_span_hz > 0) || widthHz < 1000 || widthHz > m_span_hz / 2)
+        return std::numeric_limits<double>::quiet_NaN();
+    const int center = m_bin_count / 2;
+    const int half = std::max(2, static_cast<int>(widthHz * m_bin_count / m_span_hz / 2));
+    QVector<float> noise;
+    double signal = 0; int n = 0;
+    for (int i = 2; i < m_bin_count - 2; ++i) {
+        const double db = m_bins[i];
+        if (!std::isfinite(db)) continue;
+        if (std::abs(i - center) <= half) {
+            // Reject a single-bin DC spike as a sufficient reason to stop a sweep.
+            if (i != center) { signal += std::pow(10.0, db / 10.0); ++n; }
+        } else if (std::abs(i - center) > half * 2) noise.append(static_cast<float>(db));
+    }
+    if (noise.size() < 8 || !n || signal <= 0) return std::numeric_limits<double>::quiet_NaN();
+    auto mid = noise.begin() + noise.size() / 2;
+    std::nth_element(noise.begin(), mid, noise.end());
+    return 10.0 * std::log10(signal / n) - *mid;
+}
