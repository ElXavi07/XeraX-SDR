+struct Clock { double phase=0; unsigned bits=0; unsigned since[2]={0,0}; int candidate[2]={-1,-1},hits[2]={0,0}; };
+struct Detector {
+    unsigned rate=0; uint64_t channel=0; double decimate=0,lp1=0,lp2=0,dc=0;
